# Docker runtime overrides
# Copy this file to .env on the server and edit values if needed.

# Browser-heavy tasks can consume a lot of memory. Keep 1 on 2G servers.
GPT_REGISTER_PUBLIC_PORT=47718
GO_EMAIL_PROTOCOL_MAX_ACTIVE=1
GO_GRAPH_MAX_CONCURRENT=4
GO_EMAIL_PROTOCOL_MODE=live
GO_EMAIL_PROTOCOL_TRANSPORT=tls